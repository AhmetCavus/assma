# Copy to .env (or run `npm run setup:environment`). Examples only, never live credentials.
# Local process: shared Mongo's host-bound address. Docker Compose uses DB_URI_DOCKER.
DB_URI=mongodb://assma_example:replace-with-database-password@127.0.0.1:27017/assma?authSource=assma
DB_URI_DOCKER=mongodb://assma_example:replace-with-database-password@shared-mongo:27017/assma?authSource=assma
DB_ENGINE=mongodb
DBNAME=assma
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USER=admin@yappai.de
INITIAL_ADMIN_PASS=replace-with-a-strong-password
# Local API port. ellma uses 4000, 5180 and 5181; assma uses 4100, 5182 and 5183.
PORT=4100
# Browser origins allowed to call the API (comma separated). Compose sets its own list.
ALLOWED_ORIGINS=https://assma.yappai.de,https://assma-admin.yappai.de,http://localhost:5182,http://127.0.0.1:5182,http://localhost:5183,http://127.0.0.1:5183
# The model that reads CVs and listings and assesses the fit. One provider for the whole API:
#   local  - a self-hosted model on this machine or in the LAN (the default)
#   openai - OpenAI's hosted API (needs OPENAI_API_KEY)
#   claude - Anthropic's API (needs ANTHROPIC_API_KEY)
# Hosted providers receive CVs and listings: update the privacy notice before switching.
# Left empty, assma uses the shared Ollama container from OLLAMA_* below, as before.
LLM_PROVIDER=
# The model's name at the provider, for example qwen3.5:4b, Qwen/Qwen3-14B-AWQ,
# claude-opus-5-5. Empty with Ollama means OLLAMA_MODEL.
LLM_MODEL=
# For LLM_PROVIDER=local: ollama (native API) or openai-compatible (vLLM, llama.cpp).
LLM_LOCAL_PROTOCOL=
# For LLM_PROVIDER=local: the server's address. Ollama without /api, OpenAI-compatible
# servers with /v1, for example http://192.168.178.50:8000/v1. Empty with Ollama means
# OLLAMA_URL. LLM_BASE_URL_DOCKER replaces it inside the container when the two differ.
LLM_BASE_URL=
LLM_BASE_URL_DOCKER=
# Optional bearer key for a local server started with --api-key.
LLM_API_KEY=
# Optional upper limit for an answer. Claude defaults to 32000 (thinking included); the
# others let the server decide, which for vLLM is whatever the context has left.
LLM_MAX_OUTPUT_TOKENS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# The shared Ollama container (as for ellma). Host dev uses the published port; containers
# use dev-proxy. OLLAMA_KEEP_ALIVE applies to every Ollama setup.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL_DOCKER=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m
# Public addresses used for the production build and the API's allowed origins.
ASSMA_WEB_URL=https://assma.yappai.de
ASSMA_ADMIN_URL=https://assma-admin.yappai.de
ASSMA_API_URL=https://assma-api.yappai.de
# API address the local Vite dev servers call.
VITE_API_URL=http://localhost:4100
# The internal Verdaccio registry provides the current Yappio packages.
NPM_REGISTRY=http://192.168.178.131:4873/

# Operator details for the imprint (web build). Until name, address and email are set, the
# imprint says that the details have not been entered yet. Address lines are separated by ";".
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REPRESENTATIVE=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
VITE_LEGAL_REGISTER=
VITE_LEGAL_VAT_ID=

# The source code of this installation (AGPL-3.0). Empty uses the original repository; a
# modified copy that others use must link to its own published source here.
VITE_SOURCE_URL=
