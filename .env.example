# Copy to .env (or run `npm run setup:environment`). Examples only, never live credentials.
# Local process: shared Mongo's host-bound address. Docker Compose uses DB_URI_DOCKER.
DB_URI=mongodb://assma_example:replace-with-database-password@127.0.0.1:27017/assma?authSource=assma
DB_URI_DOCKER=mongodb://assma_example:replace-with-database-password@shared-mongo:27017/assma?authSource=assma
DB_ENGINE=mongodb
DBNAME=assma
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USER=admin@yappai.de
INITIAL_ADMIN_PASS=replace-with-a-strong-password
# Local API port. ellma uses 4000, 5180 and 5181; assma uses 4100, 5182 and 5183.
PORT=4100
# Browser origins allowed to call the API (comma separated). Compose sets its own list.
ALLOWED_ORIGINS=https://assma.yappai.de,https://assma-admin.yappai.de,http://localhost:5182,http://127.0.0.1:5182,http://localhost:5183,http://127.0.0.1:5183
# Public addresses used for the production build and the API's allowed origins.
ASSMA_WEB_URL=https://assma.yappai.de
ASSMA_ADMIN_URL=https://assma-admin.yappai.de
ASSMA_API_URL=https://assma-api.yappai.de
# API address the local Vite dev servers call.
VITE_API_URL=http://localhost:4100
# The internal Verdaccio registry provides the current Yappio packages.
NPM_REGISTRY=http://192.168.178.131:4873/
